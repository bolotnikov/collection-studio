{
  "name": "collection-studio",
  "version": "0.1.1",
  "private": true,
  "description": "Reference-guided production of collectible card sets",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts/*.ts",
    "test": "vitest run",
    "prepare:references": "tsx scripts/prepare-references.ts",
    "package:mac": "npm run build && tsx scripts/package-mac.ts",
    "format": "prettier --write src tests scripts/*.ts docs/*.md README.md",
    "calibrate:codex": "tsx scripts/calibrate-codex.ts",
    "prepare:icon": "tsx scripts/prepare-icon.ts",
    "prepare:library": "tsx scripts/prepare-library.ts",
    "prepare:knowledge": "tsx scripts/prepare-knowledge.ts && npm run prepare:clean-sets",
    "prepare:clean-sets": "tsx scripts/prepare-clean-sets.ts",
    "kb:analyze-cards": "tsx scripts/sync-knowledge.ts cards",
    "kb:analyze-sets": "tsx scripts/sync-knowledge.ts sets",
    "kb:sync": "tsx scripts/sync-knowledge.ts sync",
    "docs:dev": "npm run dev --prefix website",
    "docs:build": "npm run build --prefix website",
    "docs:preview": "npm run preview --prefix website",
    "docs:check": "npm run check:links --prefix website"
  },
  "build": {
    "appId": "studio.collection.desktop",
    "productName": "Collection Studio",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/style-profile.json",
        "to": "style-profile.json"
      },
      {
        "from": "resources/references",
        "to": "references"
      },
      {
        "from": "resources/library.json",
        "to": "library.json"
      },
      {
        "from": "resources/knowledge",
        "to": "knowledge"
      },
      {
        "from": "resources/prompts",
        "to": "prompts"
      },
      {
        "from": "resources/production-config.json",
        "to": "production-config.json"
      },
      {
        "from": "resources/retrieval-config.json",
        "to": "retrieval-config.json"
      },
      {
        "from": "resources/production-rules.json",
        "to": "production-rules.json"
      },
      {
        "from": "resources/production-requirements.json",
        "to": "production-requirements.json"
      },
      {
        "from": "resources/additional-set-membership.json",
        "to": "additional-set-membership.json"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "identity": null,
      "icon": "resources/icon.icns"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
