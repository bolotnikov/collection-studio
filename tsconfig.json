{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "jsx": "react-jsx", "strict": true,
    "noUncheckedIndexedAccess": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "types": ["node"], "noEmit": true
  },
  "include": ["src", "scripts/*.ts", "tests", "electron.vite.config.ts"]
}
