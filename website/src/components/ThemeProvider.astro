<script is:inline>
  (() => {
    let theme = 'dark';
    try {
      if (localStorage.getItem('collection-studio-docs-theme') === 'light')
        theme = 'light';
    } catch {
      // A blocked storage area must not prevent the default theme from rendering.
    }
    document.documentElement.dataset.theme = theme;
  })();
</script>
